---
/**
 * Limits and honesty (DESIGN 5, row 8; copy stays close to docs/PRD.md "Risks and guarantees").
 */
const guarantees = [
  {
    id: "G1",
    text: "Against implementations that cannot write arbitrary proxy storage, the proxy changes implementation only through ConstitutionExecutor, which accepts only transactions signed for the gate's derived address.",
    caveat:
      "An implementation that can write a computed storage slot can bypass that path. The executor's tracker is not a storage-write guard.",
  },
  {
    id: "G2",
    text: "The gate requests a signature only for the exact executor call bound to a certificate from an allowlisted verifier over the active rule set.",
  },
  {
    id: "G3",
    text: "Rules, the verifier allowlist and authority change only after a public 7-day delay. Guardian actions can only reduce authority.",
    caveat:
      "A certified transaction that nobody relays delays later ones until someone does. Delay only: no signature is created without a certificate.",
  },
  { id: "G4", text: "AI output can only cause a refusal, never a certification." },
];

const assumptions = [
  "The NEAR MPC network signs honestly and stays available. Its threshold signatures are not post-quantum.",
  "The TEE vendors and attestation chains hold. Attestation proves which code ran on which input, not that its conclusion is right.",
  "Rules protect only what they declare. A dormant flaw outside R1 to R5, or beyond their bounds, can pass.",
  "Behaviour that depends on a later block time or block value is outside the checks.",
  "The AI review is nondeterministic. Its find rate comes from rehearsals and is not promised.",
  "Outages of the MPC network, the verifier or the AI delay upgrades. They never produce a signature without a certificate.",
  "The page can only read public data. A compromised page host cannot produce certificates or signatures.",
];

const notClaimed = [
  "Full formal verification.",
  "Prevention of Bybit-style incidents.",
  "Protection of any contract other than the one configured proxy.",
  "Protection against bugs the declared rules do not cover.",
  "An audit. This is a testnet build and has not been audited.",
];
---

<section id="limits" class="limits" aria-labelledby="limits-title">
  <div class="container">
    <div class="limits__head" data-reveal>
      <h2 id="limits-title">What it guarantees, and what it does not.</h2>
      <p class="lede muted">
        The claim is narrow on purpose: one proxy, on testnet, under stated trust assumptions.
        Everything below comes from the product requirements, word for word where it matters.
      </p>
    </div>

    <h3 class="limits__title">Guarantees <span class="muted">if the assumptions hold</span></h3>
    <ol class="guarantees">
      {
        guarantees.map((item, i) => (
          <li class="guarantee" data-reveal style={`--i:${i}`}>
            <span class="guarantee__id mono">{item.id}</span>
            <p class="guarantee__text">{item.text}</p>
            {item.caveat && (
              <p class="guarantee__caveat">
                <span class="mono">Condition</span>
                {item.caveat}
              </p>
            )}
          </li>
        ))
      }
    </ol>

    <div class="limits__grid">
      <div class="limits__col">
        <h3 class="limits__title">Assumptions <span class="muted">what you have to trust</span></h3>
        <ul class="limits__list">
          {
            assumptions.map((item, i) => (
              <li data-reveal style={`--i:${i}`}>
                <p>{item}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="limits__col limits__col--x">
        <h3 class="limits__title">Not claimed <span class="muted">we do not claim any of these</span></h3>
        <ul class="limits__list limits__list--x">
          {
            notClaimed.map((item, i) => (
              <li data-reveal style={`--i:${i}`}>
                <p>{item}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .limits {
    padding: var(--section-y) 0;
    border-top: 1px solid var(--line);
  }

  .limits__head {
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
    margin-bottom: var(--space-8);
  }

  h2 {
    font-size: var(--text-3xl);
  }

  .limits__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin-bottom: var(--space-5);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
  }

  .limits__title .muted {
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0;
  }

  .guarantees {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-9);
    list-style: none;
  }

  .guarantee {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .guarantee__id {
    font-size: clamp(2.5rem, 2rem + 2vw, 3.75rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .guarantee__text {
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .guarantee__caveat {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--lav-soft);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .guarantee__caveat .mono {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
  }

  .limits__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-8);
  }

  .limits__list {
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .limits__list li {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .limits__list--x li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.4;
    letter-spacing: var(--tracking-tight);
  }

  .limits__list--x li::before {
    content: "";
    position: absolute;
    left: 0;
    top: calc(var(--space-4) + 0.7em);
    width: 1rem;
    height: 2px;
    background: var(--refuse);
  }

  @media (max-width: 62rem) {
    .limits__grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
</style>
