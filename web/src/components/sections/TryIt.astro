---
import { cliTabs } from "../../data/commands.ts";
import { site } from "../../data/site.ts";
import Button from "../ui/Button.astro";
import CodeBlock from "../ui/CodeBlock.astro";

/**
 * Check it yourself (DESIGN 5 row 7): one block of read-only CLI commands, one tab each, plus the
 * way into /app for the live attacks. The final gate takes no new runs, so nothing here runs a
 * proposal; the commands only read public state.
 */
const quickstart = site.repoUrl ? `${site.repoUrl}#local-quickstart` : null;
---

<section id="try" class="try" aria-labelledby="try-title">
  <div class="container">
    <div class="try__head" data-reveal>
      <h2 id="try-title">Check it yourself.</h2>
      <p class="lede">
        Four commands read the final gate and its receipts straight from public state. None of them
        signs or spends.
      </p>
    </div>

    <div class="try__block" data-reveal>
      <CodeBlock id="try-code" label="Command" title="~/constitution" tabs={cliTabs} />
      <p class="muted try__note">
        Run from a checkout with the CLI built, on Linux or WSL2, as in the{" "}
        {quickstart ? <a href={quickstart}>local quickstart</a> : "README's local quickstart"}.
        Agents: <a href="/llms.txt">/llms.txt</a> holds the status, the limits and the commands to
        verify each claim.
      </p>
    </div>

    <aside class="try__app" aria-labelledby="try-app-title" data-reveal>
      <div class="try__app-text">
        <h3 id="try-app-title">Rather break it yourself?</h3>
        <p>Connect a NEAR wallet and attack a separate demo gate. The final gate stays untouched.</p>
      </div>
      <Button href="/app" variant="ink" size="lg" class="try__app-go">
        Run the attacks live <span aria-hidden="true">→</span>
      </Button>
    </aside>
  </div>
</section>

<style>
  .try {
    padding: var(--section-y) 0;
    background: var(--paper-2);
  }

  .try__head {
    display: grid;
    gap: var(--space-5);
    max-width: 50rem;
    margin-bottom: var(--space-7);
  }

  h2 {
    font-size: var(--text-3xl);
  }

  .try__block {
    display: grid;
    gap: var(--space-4);
    max-width: 62rem;
    min-width: 0;
  }

  .try__note {
    max-width: 62ch;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .try__app {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    max-width: 62rem;
    margin-top: var(--space-8);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--lav);
    color: var(--ink-on-lav);
  }

  .try__app-text {
    display: grid;
    gap: var(--space-2);
    max-width: 40ch;
  }

  .try__app h3 {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
  }

  .try__app-text p {
    font-size: var(--text-base);
    line-height: 1.45;
  }

  /* The ink button sits on lavender: keep its focus ring visible against both grounds. */
  .try__app :global(.btn):focus-visible {
    outline-color: var(--ink);
  }

  @media (max-width: 36rem) {
    .try__app {
      padding: var(--space-5);
    }

    .try__app :global(.try__app-go) {
      width: 100%;
    }
  }
</style>
