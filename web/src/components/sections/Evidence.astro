---
import { demoKeyless } from "../../data/demo-evidence.ts";
import { baseTxUrl, finalRuns, nearTxUrl, RECORDED_ON } from "../../data/final-evidence.ts";
import { site } from "../../data/site.ts";
import GateLedger from "../live/GateLedger.astro";
import SpikeReceipt from "../live/SpikeReceipt.astro";
import StatusBadge from "../ui/StatusBadge.astro";
import FinalEvidence from "./FinalEvidence.astro";
import FinalRuns from "./FinalRuns.astro";

/**
 * Evidence (DESIGN 5 row 6): what has actually run, each line with its source label. Three recorded
 * headline results come first, each with its transaction; then the spike beside the final gate (live
 * ledger above its recorded deployment facts); then the three receipts. Each fact lives in one
 * place: the headline links to its receipt instead of repeating it.
 * Sources: src/data/final-evidence.ts (deployments/testnet.json), BUILD-PLAN P1.4 Stage B and the
 * 2026-11-05 review checks, crates/verifier/evidence/ai (rehearsal 2026-11-06).
 */
const { drain, honest, keyDeletion, keylessAudit } = finalRuns;
const near = (hash: string) => nearTxUrl(site.nearExplorer, hash);

interface Stat {
  id: string;
  headline: string;
  detail: string;
  links: { href: string; label: string; external: boolean }[];
}

// Recorded values from 2026-11-10. The live access-key count is the ledger row below, not this page's claim.
const stats: Stat[] = [
  {
    id: "keys",
    headline: `${keyDeletion.keysAfter} access keys`,
    detail: `The gate's only access key was deleted, so nobody can redeploy the gate or add a key to it. The recorded audit then reported ${keylessAudit.check} ${keylessAudit.result}.`,
    links: [
      { href: near(keyDeletion.tx), label: "Key deletion on the NEAR explorer", external: true },
      { href: "#gate-ledger", label: "Read the live count", external: false },
    ],
  },
  {
    id: "attack",
    headline: "Attack refused",
    detail: `Proposal ${drain.proposalId}, ${drain.fixture}, refused under ${drain.ruleId} ${drain.ruleName}, reason ${drain.reasonCode}. No signature was requested and the proxy kept VaultV1.`,
    links: [
      { href: near(drain.verdictTx), label: "Verdict on the NEAR explorer", external: true },
      { href: "#receipt-drain", label: "Read the receipt", external: false },
    ],
  },
  {
    id: "upgrade",
    headline: "Honest upgrade executed",
    detail: `Proposal ${honest.proposalId}, ${honest.fixture}: R1 to R5 passed, the NEAR MPC network signed and Base Sepolia executed it in block ${honest.block.toLocaleString("en-US")}.`,
    links: [
      { href: baseTxUrl(site.baseExplorer, honest.baseTx), label: "Upgrade on Base Sepolia explorer", external: true },
      { href: "#receipt-honest", label: "Read the receipt", external: false },
    ],
  },
];

const earlier: { text: string; badge: string }[] = [
  {
    text: "83 gate tests passed: 58 unit, 18 property, 7 sandbox and integration.",
    badge: "Local test, 2026-11-05",
  },
  {
    text: "In an AI rehearsal, one returned candidate, replayed locally, reproduced the drain on VaultV2Drain only. Completions were verified as provider_tee. No find rate is claimed.",
    badge: "Local replay, 2026-11-06",
  },
];
---

<section id="evidence" class="evidence" aria-labelledby="evidence-title">
  <div class="container">
    <div class="evidence__head" data-reveal>
      <h2 id="evidence-title">What has actually run.</h2>
      <p class="lede">
        Every fact carries its source. Recorded values are saved testnet receipts; observed values
        are read from the chain by this page. Spike and local results are labeled as such, and you
        can re-check the spike in your browser.
      </p>
    </div>

    <ul class="stats" aria-label="Headline results on the final gate">
      {
        stats.map((stat, i) => (
          <li class="stat" data-reveal style={`--i:${i}`}>
            <h3 class="stat__headline">{stat.headline}</h3>
            <p class="stat__detail">{stat.detail}</p>
            <StatusBadge tone="recorded">
              Testnet, recorded <time datetime={RECORDED_ON}>{RECORDED_ON}</time>
            </StatusBadge>
            <ul class="stat__links">
              {
                stat.links.map((link) => (
                  <li>
                    <a href={link.href} rel={link.external ? "noopener" : undefined}>
                      {link.label} <span aria-hidden="true">{link.external ? "↗" : "↓"}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
        ))
      }
    </ul>

    <div class="evidence__block evidence__group" data-reveal>
      <h3 class="evidence__title">The final gate</h3>
      <h4 class="evidence__sub">Read live, now</h4>
      <GateLedger columns />
      <FinalEvidence />
    </div>

    {
      site.demoGateAccount !== null && (
        <div class="evidence__block evidence__group" data-reveal>
          <h3 class="evidence__title">The demo gate</h3>
          <p class="evidence__intro">
            The separate gate that /app attacks, read live in the same way. It holds no run of the
            final gate and the final gate holds none of its runs.
          </p>
          <p class="evidence__intro">
            <StatusBadge tone="recorded">
              Testnet, recorded <time datetime={demoKeyless.date}>{demoKeyless.date}</time>
            </StatusBadge>{" "}
            Its only access key was deleted and the audit that had failed only on that check then
            exited {demoKeyless.auditExitCode} with {demoKeyless.auditChecks} checks passed.{" "}
            <a href={near(demoKeyless.keyDeletionTx)} rel="noopener">Key deletion on the NEAR explorer ↗</a>.
            The live access-key row below is the authority.
          </p>
          <GateLedger
            id="demo-gate-ledger"
            gate={site.demoGateAccount}
            label="Demo gate status"
            columns
          />
        </div>
      )
    }

    <div class="evidence__block evidence__group" data-reveal>
      <FinalRuns />
    </div>

    <div class="evidence__block evidence__group" data-reveal>
      <h3 class="evidence__title">The recorded spike run</h3>
      <SpikeReceipt />
    </div>

    <div class="evidence__block earlier" data-reveal>
      <h3 class="evidence__title">Before the testnet runs</h3>
      <ul class="earlier__list">
        {
          earlier.map((row) => (
            <li class="earlier__row">
              <p>{row.text}</p>
              <StatusBadge tone="local">{row.badge}</StatusBadge>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .evidence {
    padding: var(--section-y) 0;
    border-top: 1px solid var(--line);
  }

  .evidence__head {
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
    margin-bottom: var(--space-8);
  }

  h2 {
    font-size: var(--text-3xl);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: var(--space-9);
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .stat {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5) var(--space-6) 0;
  }

  .stat + .stat {
    padding-left: var(--space-5);
    border-left: 1px solid var(--line);
  }

  .stat__headline {
    font-size: clamp(2.25rem, 1.3rem + 3.4vw, 4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .stat__detail {
    max-width: 34ch;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .stat__links {
    display: grid;
    gap: var(--space-1);
    list-style: none;
    font-size: var(--text-sm);
  }

  .stat__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.75rem;
    font-weight: 500;
  }

  @media (max-width: 62rem) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }

    .stat,
    .stat + .stat {
      padding: var(--space-5) 0;
      border-left: 0;
    }

    .stat + .stat {
      border-top: 1px solid var(--line);
    }
  }

  .evidence__block {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .evidence__group,
  .earlier {
    margin-top: var(--space-9);
  }

  .stats + .evidence__group {
    margin-top: 0;
  }

  .evidence__intro {
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  .evidence__title {
    font-size: var(--text-xl);
  }

  .evidence__sub {
    margin-bottom: calc(-1 * var(--space-2));
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
  }

  .earlier__list {
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .earlier__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3) var(--space-6);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .earlier__row p {
    max-width: var(--measure);
  }

  @media (max-width: 40rem) {
    .earlier__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
