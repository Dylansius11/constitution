---
import { spikeEvidence } from "../../data/evidence.ts";
import { manifestFacts } from "../../data/manifest.ts";
import { site } from "../../data/site.ts";
import GateLedger from "../live/GateLedger.astro";
import ProposalWatch from "../live/ProposalWatch.astro";
import SpikeReceipt from "../live/SpikeReceipt.astro";
import StatusBadge, { type EvidenceTone } from "../ui/StatusBadge.astro";
import FinalEvidence from "./FinalEvidence.astro";

/**
 * Evidence (DESIGN 5 row 6): what has actually run, each line with its source label.
 * Sources: docs/BUILD-PLAN.md P1.4 Stage B and the 2026-11-05 review checks, crates/verifier
 * evidence (local), crates/verifier/evidence/ai (rehearsal 2026-11-06).
 */
// Large figures, each a recorded value with its source; none of them is read live.
const figures: { value: string; label: string; tone: EvidenceTone; badge: string }[] = [
  {
    value: "1",
    label: "NEAR MPC signature that executed an upgrade on Base Sepolia",
    tone: "spike",
    badge: "Spike, 2026-11-03",
  },
  {
    value: spikeEvidence.honest.gasUsed.toLocaleString("en-US"),
    label: "Gas used by that upgrade transaction",
    tone: "spike",
    badge: "Spike, 2026-11-03",
  },
  {
    value: "83",
    label: "Gate tests passed: unit, property, sandbox",
    tone: "local",
    badge: "Local test, 2026-11-05",
  },
  {
    value: "5",
    label: `Committed rules, solc ${manifestFacts.solc}`,
    tone: "recorded",
    badge: "rules/manifest.json",
  },
];

const ledger: { part: string; state: string; tone: EvidenceTone; badge: string }[] = [
  {
    part: "Upgrade path through Chain Signatures",
    state:
      "Ran live on a minimal spike gate: the NEAR MPC network signed an upgrade transaction for a NEAR contract, and it executed on Base Sepolia. No verifier was in that loop.",
    tone: "spike",
    badge: "Spike, 2026-11-03",
  },
  {
    part: "Gate contract",
    state:
      "Deployed on NEAR testnet as constitution-gate.testnet and exercised by the three recorded runs below. Local suite: 83 tests passed on 2026-11-05 (58 unit, 18 property, 7 sandbox and integration).",
    tone: "recorded",
    badge: "Testnet, recorded 2026-11-10",
  },
  {
    part: "Attested verifier, R1 to R5",
    state:
      "Runs in a Phala TDX confidential VM, and its appraisal passed on 2026-11-10. On testnet, R2 refused VaultV2Drain and R1 to R5 passed VaultV2Honest. The same checks ran locally first.",
    tone: "recorded",
    badge: "Testnet, recorded 2026-11-10",
  },
  {
    part: "Private red-team AI",
    state:
      "On testnet the honest upgrade's review used NEAR AI Cloud, verified as provider_tee, and reproduced none of 4 candidates. In a 2026-11-06 rehearsal a returned candidate, replayed locally, reproduced the drain on VaultV2Drain only. No find rate is claimed.",
    tone: "recorded",
    badge: "Testnet, recorded 2026-11-10",
  },
  {
    part: "Gate access keys",
    state:
      "On 2026-11-10 the gate's only access key was deleted, and the recorded audit then reported zero access keys. The Gate access keys row below reads the chain now; zero keys means keyless.",
    tone: "recorded",
    badge: "Testnet, recorded 2026-11-10",
  },
];
---

<section id="evidence" class="evidence" aria-labelledby="evidence-title">
  <div class="container">
    <div class="evidence__head" data-reveal>
      <h2 id="evidence-title">What has actually run.</h2>
      <p class="lede">
        Every fact on this page carries its source. Local tests are labeled local, the spike is
        labeled spike, saved testnet receipts are labeled recorded, and nothing is shown as
        observed until this page has read it from the chain.
      </p>
    </div>

    <aside class="verify" aria-labelledby="verify-title" data-reveal>
      <h3 id="verify-title" class="verify__title">Check it yourself in three steps</h3>
      <ol class="verify__steps">
        <li>
          <span class="verify__n mono" aria-hidden="true">1</span>
          <p>Find the recorded spike run below. It lists the NEAR and Base Sepolia transaction hashes.</p>
        </li>
        <li>
          <span class="verify__n mono" aria-hidden="true">2</span>
          <p>Press <strong>Re-check on Base Sepolia</strong>. Your browser asks the chain directly, not our server.</p>
        </li>
        <li>
          <span class="verify__n mono" aria-hidden="true">3</span>
          <p>Compare. The current implementation should match the recorded one, and the explorer link opens the same transaction.</p>
        </li>
      </ol>
      <p class="verify__foot">
        <a class="verify__go" href="#receipt-spike">Go to the re-check <span aria-hidden="true">↓</span></a>
        <span class="muted">This re-check covers the recorded spike. The final gate's receipts are recorded below, and its state is read live in the ledger.</span>
      </p>
    </aside>

    <ul class="figures" aria-label="Recorded figures">
      {
        figures.map((figure, i) => (
          <li class="figure" data-reveal style={`--i:${i}`}>
            <p class="figure__value mono">{figure.value}</p>
            <p class="figure__label">{figure.label}</p>
            <StatusBadge tone={figure.tone}>{figure.badge}</StatusBadge>
          </li>
        ))
      }
    </ul>

    <ol class="ledger" aria-label="Status by component">
      {
        ledger.map((row, i) => (
          <li class="ledger__row" data-reveal style={`--i:${i}`}>
            <h3 class="ledger__part">{row.part}</h3>
            <p class="ledger__state">{row.state}</p>
            <div class="ledger__badge">
              <StatusBadge tone={row.tone}>{row.badge}</StatusBadge>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="evidence__block evidence__final" data-reveal>
      <FinalEvidence />
    </div>

    <div class="evidence__pair">
      <div class="evidence__block" data-reveal>
        <h3 class="evidence__title">The recorded spike run</h3>
        <SpikeReceipt />
      </div>
      <div class="evidence__block" data-reveal style="--i:1">
        <h3 class="evidence__title">The final gate, read live</h3>
        <GateLedger />
        {site.gateAccount && <ProposalWatch />}
      </div>
    </div>
  </div>
</section>

<style>
  .evidence {
    padding: var(--section-y) 0;
    border-top: 1px solid var(--line);
  }

  .evidence__head {
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
    margin-bottom: var(--space-8);
  }

  h2 {
    font-size: var(--text-3xl);
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-bottom: var(--space-9);
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .figure {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
  }

  .figure + .figure {
    padding-left: var(--space-5);
    border-left: 1px solid var(--line);
  }

  .figure__value {
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4.75rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .figure__label {
    max-width: 22ch;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  @media (max-width: 62rem) {
    .figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .figure:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .figure:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 30rem) {
    .figures {
      grid-template-columns: minmax(0, 1fr);
    }

    .figure + .figure {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }

  .ledger {
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .ledger__row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr) 11.5rem;
    gap: var(--space-3) var(--space-6);
    align-items: baseline;
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--line);
  }

  .ledger__part {
    font-size: var(--text-base);
    letter-spacing: -0.01em;
  }

  .ledger__state {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .ledger__badge {
    justify-self: end;
  }

  .evidence__final {
    margin-top: var(--space-9);
  }

  .evidence__pair {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--space-7);
    margin-top: var(--space-9);
    align-items: start;
  }

  .evidence__block {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .evidence__title {
    font-size: var(--text-xl);
  }

  @media (max-width: 62rem) {
    .ledger__row {
      grid-template-columns: 1fr;
    }

    .ledger__badge {
      justify-self: start;
    }

    .evidence__pair {
      grid-template-columns: 1fr;
    }
  }

  .verify {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-7);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-md);
    background: var(--lav-soft);
    color: var(--ink-on-lav);
  }

  .verify__title {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
  }

  .verify__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
    list-style: none;
  }

  .verify__steps li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .verify__n {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--ink-on-lav);
    color: var(--lav-soft);
    font-size: var(--text-sm);
  }

  .verify__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
  }

  .verify__foot .muted {
    color: var(--ink-on-lav);
    opacity: 0.8;
  }

  .verify__go {
    font-weight: 600;
    color: var(--ink-on-lav);
  }
</style>
