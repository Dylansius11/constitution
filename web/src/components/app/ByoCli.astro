---
import CopyButton from "../ui/CopyButton.astro";

/**
 * Bring your own candidate. The flags are those of `constitution propose` and
 * `constitution verifier run` in `crates/cli/src/main.rs`; nothing else is offered here.
 */
interface Props {
  gate: string;
  verifierUrl: string;
}

const { gate, verifierUrl } = Astro.props;
const propose = [
  "constitution propose \\",
  "  --account <you>.testnet \\",
  `  --gate ${gate} \\`,
  "  --bundle contracts \\",
  "  --contract src/<File>.sol:<Contract> \\",
  "  --impl <address of your deployed implementation> \\",
  "  --init 0x \\",
  `  --verifier ${verifierUrl}`,
].join("\n");
const watch = [`constitution status <proposal id> --gate ${gate} --watch 2`].join("\n");
const rerun = [
  "constitution verifier run \\",
  "  --proposal <proposal id> \\",
  "  --bundle contracts \\",
  "  --contract src/<File>.sol:<Contract> \\",
  `  --gate ${gate} \\`,
  `  --verifier-url ${verifierUrl}`,
].join("\n");
---

<section id="byo" class="app-byo" aria-labelledby="byo-title">
  <h2 id="byo-title">Bring your own (CLI)</h2>
  <p class="app-section-lede">
    The gate checks one vault, so your candidate has to be a Vault variant: it keeps VaultV1's
    storage layout and its deposit and withdraw interface. Deploy it to Base Sepolia, then propose
    it with your own NEAR account. You need credit on the gate first; the step above funds it.
  </p>
  <ol>
    <li>
      Put your contract in <code>contracts/src/</code> and deploy its implementation to Base
      Sepolia. Its runtime code hash must equal what the verifier compiles from your source.
    </li>
    <li>
      Propose it. The CLI registers the source commitment on the gate, seals the bundle to the
      demo verifier and starts the run.
    </li>
    <li>Watch the proposal. A run that never started can be re-sealed without a new proposal.</li>
  </ol>
  <div class="app-byo__block">
    <pre class="app-cli" tabindex="0" aria-label="Propose from the CLI"><code>{propose}</code></pre>
    <CopyButton value={propose} label="propose command" />
  </div>
  <div class="app-byo__block">
    <pre class="app-cli" tabindex="0" aria-label="Watch from the CLI"><code>{watch}</code></pre>
    <CopyButton value={watch} label="status command" />
  </div>
  <div class="app-byo__block">
    <pre class="app-cli" tabindex="0" aria-label="Re-run the verifier from the CLI"><code>{rerun}</code></pre>
    <CopyButton value={rerun} label="verifier run command" />
  </div>
  <p class="muted">
    The CLI reads your key from <code>.secrets/near-credentials/testnet/&lt;you&gt;.json</code> or
    <code>--key-file</code>. It does not appraise the verifier; read the identity yourself before you
    seal private source.
  </p>
</section>

<style>
  .app-byo__block {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    min-width: 0;
  }

  .app-byo__block :global(.app-cli) {
    width: 100%;
  }
</style>
