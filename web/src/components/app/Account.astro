---
/**
 * The visitor's side of the demo: wallet, credit and session key. Static markup with data hooks;
 * `app.ts` owns every state change. Nothing here claims a fact until the script has read it.
 */
interface Props {
  gate: string;
  allowanceNear: string;
}

const { gate, allowanceNear } = Astro.props;
---

<section id="account" class="app-account" aria-labelledby="account-title" data-account data-wallet="idle">
  <h2 id="account-title">Your account</h2>

  <ol class="app-steps">
    <li class="app-step" data-step="connect" data-state="current">
      <div class="app-step__head">
        <span class="app-step__n" aria-hidden="true">1</span>
        <span class="app-step__title">Connect a NEAR wallet</span>
        <span class="app-step__status" data-step-status>Not connected</span>
      </div>
      <div class="app-step__body">
        <p data-connect-help>
          Pick any wallet in the list that supports NEAR testnet. Nothing here touches mainnet funds.
        </p>
        <div class="app-account__id" data-connected hidden>
          <code data-account-id></code>
          <button type="button" class="app-btn app-btn--quiet app-btn--inline" data-disconnect>
            Disconnect
          </button>
        </div>
        <button type="button" class="app-btn" data-connect>Connect wallet</button>
        <p class="app-message" data-wallet-message role="status" hidden></p>
      </div>
    </li>

    <li class="app-step" data-step="enable" data-state="locked">
      <div class="app-step__head">
        <span class="app-step__n" aria-hidden="true">2</span>
        <span class="app-step__title">Enable live runs</span>
        <span class="app-step__status" data-step-status>Locked</span>
      </div>
      <div class="app-step__body">
        <p>
          One wallet confirmation prepays credit on the demo gate and adds a session key to your
          account, so the attacks below do not ask you again.
        </p>
        <dl class="app-facts">
          <div><dt>Credit on the gate</dt><dd data-fact="credit">Not read</dd></div>
          <div><dt>Attacks it covers</dt><dd data-fact="runs">Not read</dd></div>
          <div><dt>Session key</dt><dd data-fact="key">Not read</dd></div>
          <div><dt>Cost per attack</dt><dd data-fact="fee">Not read</dd></div>
        </dl>
        <label class="app-field">
          <span>Prepay for</span>
          <select data-attempts>
            <option value="5">5 attacks</option>
            <option value="10" selected>10 attacks</option>
            <option value="25">25 attacks</option>
          </select>
        </label>
        <p data-deposit-note>Reading the gate's fees.</p>
        <button type="button" class="app-btn" data-enable aria-disabled="true">Enable live runs</button>
        <div class="app-actions" data-manage hidden>
          <button type="button" class="app-btn app-btn--quiet app-btn--inline" data-withdraw>
            Withdraw credit
          </button>
          <button type="button" class="app-btn app-btn--quiet app-btn--inline" data-remove-key>
            Remove session key
          </button>
          <button type="button" class="app-btn app-btn--quiet app-btn--inline" data-refresh>
            Refresh
          </button>
        </div>
        <p class="app-message" data-setup-message role="status" hidden></p>
        <details class="app-key-note">
          <summary>What the session key can do</summary>
          <p>
            It is a function-call key limited to <code>propose</code> on <code>{gate}</code>, with a
            gas allowance of {allowanceNear} NEAR. It cannot move funds, withdraw credit or call
            any other contract. It lives in this browser's storage; remove it here at any time.
            Credit is yours to withdraw whenever no proposal of yours is in flight.
          </p>
        </details>
      </div>
    </li>

    <li class="app-step" data-step="run" data-state="locked">
      <div class="app-step__head">
        <span class="app-step__n" aria-hidden="true">3</span>
        <span class="app-step__title">Run an attack</span>
        <span class="app-step__status" data-step-status>Locked</span>
      </div>
      <div class="app-step__body">
        <p data-run-summary>Connect a wallet and enable live runs to unlock the attacks.</p>
        <div class="app-active" data-active-panel hidden>
          <p data-active-text></p>
          <button type="button" class="app-btn app-btn--quiet app-btn--inline" data-expire hidden>
            Release it
          </button>
          <p class="app-message" data-active-message role="status" hidden></p>
        </div>
      </div>
    </li>
  </ol>
</section>
