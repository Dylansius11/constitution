---
import { manifestFacts as m } from "../../data/manifest.ts";

/**
 * One small illustration per committed rule (DESIGN 5 row 4). They show the shape of each check, not
 * a real run: slot names, bars and transaction rows are schematic. Committed values (forbidden
 * opcodes, the initializer selector, the R2 depth) come from rules/manifest.json.
 *
 * Static baseline is the finished picture. `rules.ts` adds `is-on` to the row when it scrolls in and
 * CSS plays the check; the start state exists only with JavaScript and motion allowed.
 */
interface Props {
  rule: "R1" | "R2" | "R3" | "R4" | "R5";
}

const { rule } = Astro.props;

const opcodes = ["PUSH1", "SLOAD", "CALL", "SSTORE", "RETURN", ...m.r3.forbidden_opcodes];
const ordered = [opcodes[0], opcodes[5], opcodes[1], opcodes[2], opcodes[6], opcodes[3], opcodes[4], opcodes[7]].filter(
  (op): op is string => typeof op === "string",
);
const forbidden = new Set(m.r3.forbidden_opcodes);
const depth = m.r2.invariant_depth;
const sequence = Array.from({ length: depth }, (_, i) => (i % 2 === 0 ? "deposit" : "withdraw"));
const selector = m.r4.allowlist[0] ?? "";
---

<figure class:list={["fig", `fig--${rule.toLowerCase()}`]} aria-hidden="true">
  <p class="fig__tag mono">Illustration</p>

  {
    rule === "R1" && (
      <div class="r1">
        <div class="r1__col">
          <p class="fig__label mono">current</p>
          <ol>
            {[0, 1, 2].map((n) => (
              <li class="mono">slot {n}</li>
            ))}
          </ol>
        </div>
        <div class="r1__col">
          <p class="fig__label mono">proposed</p>
          <ol>
            {[0, 1, 2].map((n) => (
              <li class="mono r1__same" style={`--i:${n}`}>
                slot {n}
                <span class="r1__eq">same</span>
              </li>
            ))}
            <li class="mono r1__new">slot 3 · appended</li>
          </ol>
        </div>
      </div>
    )
  }

  {
    rule === "R2" && (
      <div class="r2">
        <ol class="r2__seq">
          {sequence.map((step, i) => (
            <li class="mono" style={`--i:${i}`}>
              {step}
            </li>
          ))}
        </ol>
        <div class="r2__bars">
          <div class="r2__bar">
            <span class="r2__fill r2__fill--held" />
            <p class="fig__label mono">held</p>
          </div>
          <p class="r2__op mono">≥</p>
          <div class="r2__bar">
            <span class="r2__fill r2__fill--owed" />
            <p class="fig__label mono">owed</p>
          </div>
        </div>
        <p class="fig__label mono">checked after every step, depth {depth}</p>
      </div>
    )
  }

  {
    rule === "R3" && (
      <div class="r3">
        <ul class="r3__ops">
          {ordered.map((op, i) => (
            <li class:list={["mono", { "r3__bad": forbidden.has(op) }]} style={`--i:${i}`}>
              {op}
            </li>
          ))}
        </ul>
        <span class="r3__scan" />
      </div>
    )
  }

  {
    rule === "R4" && (
      <div class="r4">
        <p class="fig__label mono">init calldata</p>
        <p class="r4__data mono">
          <span class="r4__sel">{selector}</span>
          <span class="r4__args">…arguments</span>
        </p>
        <p class="fig__label mono">committed selector</p>
        <p class="r4__allow mono">
          {selector}
          <span class="r4__ok">matches</span>
        </p>
      </div>
    )
  }

  {
    rule === "R5" && (
      <div class="r5">
        <p class="fig__label mono">old code</p>
        <span />
        <p class="fig__label mono">new code</p>
        {[1, 2, 3, 4].map((n) => (
          <>
            <p class="mono r5__cell" style={`--i:${n}`}>
              tx {n} · output
            </p>
            <p class="mono r5__eq" style={`--i:${n}`}>
              =
            </p>
            <p class="mono r5__cell" style={`--i:${n}`}>
              tx {n} · output
            </p>
          </>
        ))}
      </div>
    )
  }
</figure>

<style>
  .fig {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 13rem;
    padding: var(--space-6) var(--space-5) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    font-size: var(--text-xs);
    overflow: clip;
  }

  .fig__tag {
    position: absolute;
    top: var(--space-3);
    left: var(--space-4);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-mono);
    color: var(--ink-muted);
  }

  .fig__label {
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-mono);
    color: var(--ink-muted);
  }

  ol,
  ul {
    list-style: none;
  }

  /* ---- R1: append-only layout ---- */
  .r1 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .r1 ol {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  .r1 li {
    display: flex;
    justify-content: space-between;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }

  .r1__eq {
    color: var(--pass);
  }

  .r1__new {
    border-color: var(--ink) !important;
    background: var(--lav) !important;
  }

  /* ---- R2: held never below owed ---- */
  .r2 {
    display: grid;
    gap: var(--space-4);
  }

  .r2__seq {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .r2__seq li {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
  }

  .r2__bars {
    display: flex;
    align-items: end;
    gap: var(--space-4);
    height: 5.5rem;
  }

  .r2__bar {
    display: grid;
    align-content: end;
    justify-items: center;
    gap: var(--space-1);
    width: 3.5rem;
  }

  .r2__fill {
    display: block;
    width: 100%;
    border-radius: 3px 3px 0 0;
    transform-origin: bottom;
  }

  .r2__fill--held {
    height: 4.25rem;
    background: var(--ink);
  }

  .r2__fill--owed {
    height: 3.25rem;
    background: var(--lav);
    border: 1px solid var(--ink);
  }

  .r2__op {
    align-self: center;
    font-size: var(--text-lg);
  }

  /* ---- R3: opcode filter ---- */
  .r3 {
    position: relative;
  }

  .r3__ops {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-1);
  }

  .r3__ops li {
    position: relative;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }

  .r3__bad {
    border-color: var(--refuse) !important;
    color: var(--refuse);
  }

  .r3__bad::after {
    content: "";
    position: absolute;
    inset: 50% 0.4rem auto;
    height: 1.5px;
    background: var(--refuse);
    transform-origin: left;
  }

  .r3__scan {
    position: absolute;
    inset: -0.5rem auto -0.5rem 0;
    width: 2px;
    background: var(--violet);
    opacity: 0;
  }

  /* ---- R4: initializer allowlist ---- */
  .r4 {
    display: grid;
    gap: var(--space-2);
  }

  .r4__data,
  .r4__allow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    margin-bottom: var(--space-2);
  }

  .r4__sel {
    padding: 0.05rem 0.25rem;
    border-radius: 2px;
    background: var(--lav);
  }

  .r4__args {
    color: var(--ink-muted);
  }

  .r4__ok {
    margin-left: auto;
    color: var(--pass);
  }

  /* ---- R5: differential replay ---- */
  .r5 {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-1) var(--space-3);
    align-items: center;
  }

  .r5__cell {
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }

  .r5__eq {
    color: var(--pass);
    font-size: var(--text-base);
  }

  /* ---- Played state: start positions exist only with JavaScript and motion allowed ---- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.rules.has-js .rule:not(.is-on)) .r1__new {
      opacity: 0;
      transform: translateY(-10px);
    }

    :global(.rules.has-js .rule:not(.is-on)) .r1__eq,
    :global(.rules.has-js .rule:not(.is-on)) .r4__ok,
    :global(.rules.has-js .rule:not(.is-on)) .r5__eq {
      opacity: 0;
    }

    :global(.rules.has-js .rule:not(.is-on)) .r2__fill {
      transform: scaleY(0);
    }

    :global(.rules.has-js .rule:not(.is-on)) .r2__seq li {
      opacity: 0.25;
    }

    :global(.rules.has-js .rule:not(.is-on)) .r3__bad {
      border-color: var(--line) !important;
      color: inherit;
    }

    :global(.rules.has-js .rule:not(.is-on)) .r3__bad::after {
      transform: scaleX(0);
    }

    :global(.rules.has-js .rule:not(.is-on)) .r4__sel {
      background: transparent;
    }

    :global(.rules.has-js .rule:not(.is-on)) .r5__cell {
      opacity: 0;
      transform: translateY(6px);
    }

    .r1__new,
    .r5__cell {
      transition:
        opacity 500ms var(--ease-out),
        transform 600ms var(--ease-out);
    }

    .r1__new {
      transition-delay: 500ms;
    }

    .r1__eq {
      transition: opacity 300ms var(--ease-out) calc(var(--i, 0) * 120ms + 100ms);
    }

    .r2__seq li {
      transition: opacity 300ms var(--ease-out) calc(var(--i, 0) * 220ms);
    }

    .r2__fill {
      transition: transform 900ms var(--ease-out) 300ms;
    }

    .r2__fill--owed {
      transition-delay: 500ms;
    }

    .r3__ops li {
      transition:
        border-color 200ms ease calc(var(--i, 0) * 90ms + 150ms),
        color 200ms ease calc(var(--i, 0) * 90ms + 150ms);
    }

    .r3__bad::after {
      transition: transform 300ms var(--ease-out) calc(var(--i, 0) * 90ms + 250ms);
    }

    :global(.rules.has-js .rule.is-on) .r3__scan {
      animation: r3-scan 1.1s var(--ease-in-out) 1;
    }

    .r4__sel {
      transition: background-color 400ms ease 300ms;
    }

    .r4__ok {
      transition: opacity 400ms var(--ease-out) 800ms;
    }

    .r5__cell {
      transition-delay: calc(var(--i, 0) * 140ms);
    }

    .r5__eq {
      transition: opacity 300ms ease calc(var(--i, 0) * 140ms + 200ms);
    }
  }

  @keyframes r3-scan {
    0% {
      left: 0;
      opacity: 0;
    }

    10%,
    90% {
      opacity: 1;
    }

    100% {
      left: 100%;
      opacity: 0;
    }
  }
</style>
