---
import Button from "../ui/Button.astro";
import Logo from "../ui/Logo.astro";

interface Props {
  /** True on `/app`: section links point back at the landing page. */
  app?: boolean;
}

const { app = false } = Astro.props;
const prefix = app ? "/" : "";
const links = [
  { href: `${prefix}#plain`, label: "Start here" },
  { href: `${prefix}#how`, label: "How it works" },
  { href: `${prefix}#rules`, label: "Rules" },
  { href: `${prefix}#timelock`, label: "Timelock" },
  { href: `${prefix}#evidence`, label: "Evidence" },
  { href: `${prefix}#limits`, label: "Limits" },
];

// The wide bar has no room for a seventh link next to the app button; the compact menu does.
const menuLinks = [...links, { href: `${prefix}#try`, label: "Check it yourself" }];
---

<header class="header">
  <div class="header__inner container">
    <Logo href={app ? "/" : "#top"} class="header__logo" />
    <span class="header__scope">Testnet · Not audited</span>
    <nav class="header__nav" aria-label="Sections">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <details class="header__menu">
      <summary>Menu</summary>
      <nav aria-label="Sections, compact">
        <ul>
          {menuLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    </details>
    {
      app ? (
        <Button href="/" variant="secondary" class="header__cta">The story</Button>
      ) : (
        <Button href="/app" class="header__cta">Open app</Button>
      )
    }
  </div>
</header>

<script>
  // Close the compact menu after choosing a section.
  const menu = document.querySelector<HTMLDetailsElement>(".header__menu");
  menu?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) menu.open = false;
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: var(--header-h);
  }

  .header__logo {
    color: var(--ink);
  }

  .header__scope {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav ul,
  .header__menu ul {
    list-style: none;
    display: flex;
    gap: var(--space-1);
  }

  .header__nav a,
  .header__menu a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 450;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color var(--dur-base) ease;
  }

  .header__nav a:hover {
    background: rgb(23 21 31 / 0.05);
  }

  .header__menu {
    display: none;
    position: relative;
    margin-left: auto;
  }

  .header__menu summary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .header__menu summary::-webkit-details-marker {
    display: none;
  }

  .header__menu[open] summary {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .header__menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    min-width: 13rem;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .header__menu ul {
    flex-direction: column;
  }

  .header__menu a {
    width: 100%;
  }

  @media (max-width: 74rem) {
    .header__nav {
      display: none;
    }

    .header__menu {
      display: block;
    }
  }

  /* The scope chip moves into the hero below this width, so the bar keeps room for the app button. */
  @media (max-width: 48rem) {
    .header__scope {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .header__inner {
      gap: var(--space-2);
    }

    .header__inner :global(.header__logo) {
      font-size: 1.125rem;
    }

    .header__menu summary {
      padding: 0 var(--space-3);
    }

    .header__inner :global(.header__cta) {
      padding: 0 var(--space-3);
    }
  }

  /* Smallest phones: the mark alone stands for the logo; the link keeps its accessible name. */
  @media (max-width: 21rem) {
    .header__inner :global(.header__logo .logo__word) {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
