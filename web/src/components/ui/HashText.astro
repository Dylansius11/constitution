---
import { type HashKind, shortValue, spokenValue } from "../../lib/display.ts";
import CopyButton from "./CopyButton.astro";

/**
 * A hash, address or NEAR id: shortened per DESIGN 7.5 (narrow under 640 px, wide above), an
 * Expand disclosure with the full value, and a Copy button. Never hover-only.
 */
interface Props {
  value: string;
  kind?: HashKind;
  /** Spoken label, for example "Base Sepolia transaction hash". */
  label: string;
  /** Link the full value only when the page or the recorded evidence observed it. */
  href?: string;
  tone?: "light" | "dark";
  class?: string;
}

const { value, kind = "hash", label, href, tone = "light", class: className } = Astro.props;
const narrow = shortValue(value, kind, "narrow");
const wide = shortValue(value, kind, "wide");
const truncated = wide !== value || narrow !== value;
---

<span class:list={["hash", `hash--${tone}`, className]}>
  <details class="hash__details">
    <summary aria-label={`${spokenValue(label, value)}. Show full value.`}>
      <code class="hash__short" aria-hidden="true">
        <span class="hash__narrow">{narrow}</span><span class="hash__wide">{wide}</span>
      </code>
      {
        truncated && (
          <span class="hash__more" aria-hidden="true">
            <span class="hash__closed">Full</span>
            <span class="hash__opened">Less</span>
          </span>
        )
      }
    </summary>
    <code class="hash__full">{value}</code>
  </details>
  <CopyButton label={label.toLowerCase()} value={value} tone={tone} />
  {
    href && (
      <a class="hash__link" href={href} rel="noopener">
        {href.includes("nearblocks") ? "View on NEAR testnet explorer" : "View on Base Sepolia explorer"}
      </a>
    )
  }
</span>

<style is:global>
  .hash {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    max-width: 100%;
  }

  .hash__details {
    min-width: 0;
  }

  .hash__details summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    cursor: pointer;
    border-radius: 2px;
  }

  .hash__details summary::-webkit-details-marker {
    display: none;
  }

  .hash__short {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums slashed-zero;
  }

  .hash__wide {
    display: none;
  }

  @media (min-width: 40rem) {
    .hash__narrow {
      display: none;
    }

    .hash__wide {
      display: inline;
    }
  }

  .hash__more {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hash__details[open] .hash__short {
    display: none;
  }

  .hash__opened,
  .hash__details[open] .hash__closed {
    display: none;
  }

  .hash__details[open] .hash__opened {
    display: inline;
  }

  .hash__full {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
    word-break: break-all;
  }

  .hash__link {
    font-size: var(--text-sm);
  }

  .hash--dark .hash__more {
    color: var(--night-muted);
  }

  .hash--dark .hash__link {
    color: var(--lav);
  }
</style>
