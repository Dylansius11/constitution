---
import Mark from "./Mark.astro";

interface Props {
  /** "sm" for the header, "xl" for the footer signature. */
  size?: "sm" | "xl";
  href?: string;
  class?: string;
}

const { size = "sm", href, class: className } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class:list={["logo", `logo--${size}`, className]} href={href}>
  <Mark size="1em" class="logo__mark" />
  <span class="logo__word">Constitution</span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.32em;
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .logo--sm {
    font-size: 1.375rem;
  }

  .logo--xl {
    font-size: clamp(3rem, 1.4rem + 7vw, 7.5rem);
    letter-spacing: -0.045em;
    gap: 0.22em;
  }

  .logo__mark {
    width: 0.92em;
    height: 0.92em;
  }

  a.logo:focus-visible {
    outline-offset: 6px;
  }
</style>
