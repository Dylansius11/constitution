---
import type { CodeTab } from "./code-types.ts";
import CopyButton from "./CopyButton.astro";

/**
 * Command block with optional audience tabs (the "Human / Agent" pattern). Each tab holds real
 * commands; Copy copies the selected tab's commands without prompts or comments.
 * Without JavaScript every tab renders stacked under its own label.
 */

interface Props {
  /** Unique on the page; prefixes ids. */
  id: string;
  /** Accessible name of the tab list, for example "Audience". */
  label: string;
  tabs: CodeTab[];
  /** Window title shown in the bar, for example the working directory. */
  title?: string;
  class?: string;
}

const { id, label, tabs, title, class: className } = Astro.props;
const copyText = (tab: CodeTab): string =>
  tab.lines
    .flatMap((line) => (line.cmd ? [line.cmd] : []))
    .join("\n");
---

<div class:list={["code", className]} data-code-tabs>
  <div class="code__bar">
    {title && <p class="code__title" aria-hidden="true">{title}</p>}
    {
      tabs.length > 1 && (
        <div class="code__tabs" role="tablist" aria-label={label} hidden>
          {tabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              id={`${id}-tab-${tab.id}`}
              aria-controls={`${id}-panel-${tab.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
            >
              {tab.label}
            </button>
          ))}
        </div>
      )
    }
  </div>
  {
    tabs.map((tab, index) => (
      <div
        class="code__panel"
        id={`${id}-panel-${tab.id}`}
        role={tabs.length > 1 ? "tabpanel" : undefined}
        aria-labelledby={tabs.length > 1 ? `${id}-tab-${tab.id}` : undefined}
        data-initial={index === 0 ? "true" : "false"}
      >
        {tabs.length > 1 && <p class="code__nojs-label">{tab.label}</p>}
        <div class="code__head">
          <CopyButton label={`${tab.label.toLowerCase()} commands`} value={copyText(tab)} tone="dark" />
        </div>
        <pre tabindex="0" aria-label={`${tab.label} commands`}><code>{tab.lines.map((line, i) =>
          line.cmd ? (
            <span class="code__line" style={`--i:${i}`}><span class="code__prompt" aria-hidden="true">$ </span>{line.cmd}</span>
          ) : (
            <span class="code__note" style={`--i:${i}`}>{`# ${line.note ?? ""}`}</span>
          ),
        )}</code></pre>
      </div>
    ))
  }
</div>

<script>
  // Lines print in once when the block scrolls into view; never for reduced motion.
  const reveal = matchMedia("(prefers-reduced-motion: no-preference)").matches
    ? new IntersectionObserver(
        (entries, observer) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-on");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -20% 0px" },
      )
    : null;

  for (const root of document.querySelectorAll<HTMLElement>("[data-code-tabs]")) {
    if (reveal && root.getBoundingClientRect().top > innerHeight) {
      root.classList.add("is-armed");
      reveal.observe(root);
    }
    const list = root.querySelector<HTMLElement>("[role=tablist]");
    if (!list) continue;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (next: HTMLButtonElement, focus: boolean): void => {
      for (const tab of tabs) {
        const on = tab === next;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !on;
      }
      if (focus) next.focus();
    };
    list.hidden = false;
    root.classList.add("is-tabbed");
    const first = tabs[0];
    if (first) select(first, false);
    list.addEventListener("click", (event) => {
      const tab = (event.target as Element).closest<HTMLButtonElement>("[role=tab]");
      if (tab) select(tab, false);
    });
    list.addEventListener("keydown", (event) => {
      const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (current < 0) return;
      const moves: Record<string, number> = {
        ArrowRight: (current + 1) % tabs.length,
        ArrowLeft: (current - 1 + tabs.length) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      };
      const target = moves[event.key];
      const tab = target === undefined ? undefined : tabs[target];
      if (!tab) return;
      event.preventDefault();
      select(tab, true);
    });
  }
</script>

<style>
  .code {
    position: relative;
    border-radius: var(--radius-md);
    background: var(--night);
    color: var(--night-text);
    overflow: hidden;
  }

  .code__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.25rem;
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-5);
    border-bottom: 1px solid color-mix(in oklab, var(--night-text) 10%, transparent);
  }

  .code__title {
    margin-right: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--night-muted);
  }

  @media (max-width: 36rem) {
    .code__title {
      display: none;
    }
  }

  .code__title::before {
    content: "";
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: var(--lav);
    vertical-align: 0.05em;
  }

  .code__tabs {
    display: inline-flex;
    margin-right: 6.5rem;
    padding: 3px;
    border: 1px solid color-mix(in oklab, var(--night-text) 14%, transparent);
    border-radius: calc(var(--radius-sm) + 3px);
  }

  .code__tabs[hidden] {
    display: none;
  }

  .code__tabs button {
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--night-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--dur-base) ease,
      color var(--dur-base) ease;
  }

  .code__tabs button:hover {
    color: var(--night-text);
  }

  .code__tabs button[aria-selected="true"] {
    background: var(--lav);
    color: var(--ink);
  }

  .code__tabs button:focus-visible {
    outline-color: var(--lav);
    outline-offset: 2px;
  }

  .code__panel {
    position: relative;
    padding: var(--space-2) 0 var(--space-4);
  }

  .code__panel + .code__panel {
    border-top: 1px solid color-mix(in oklab, var(--night-text) 10%, transparent);
  }

  .is-tabbed .code__panel + .code__panel {
    border-top: 0;
  }

  .code__nojs-label {
    padding: var(--space-3) var(--space-5) 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--night-muted);
  }

  .is-tabbed .code__nojs-label {
    display: none;
  }

  .code__head {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
  }

  .is-tabbed .code__head {
    top: calc(-3.25rem + var(--space-2) + 1px);
  }

  /* Long commands wrap with a hanging indent under the prompt instead of scrolling sideways. */
  pre {
    margin: 0;
    padding: var(--space-5) var(--space-5) var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    tab-size: 2;
  }

  .code__line,
  .code__note {
    display: block;
    padding-left: 2ch;
    text-indent: -2ch;
  }

  .code__note {
    margin-top: var(--space-3);
  }

  .code__note:first-child {
    margin-top: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .code.is-armed:not(.is-on) :is(.code__line, .code__note) {
      opacity: 0;
      transform: translateY(4px);
    }

    .code__line,
    .code__note {
      transition:
        opacity 400ms var(--ease-out) calc(var(--i, 0) * 70ms),
        transform 400ms var(--ease-out) calc(var(--i, 0) * 70ms);
    }
  }

  pre:focus-visible {
    outline: 2px solid var(--lav);
    outline-offset: -4px;
  }

  .code__prompt {
    color: var(--lav);
    user-select: none;
  }

  .code__note {
    color: var(--night-muted);
  }
</style>
