---
import type { CodeTab } from "./code-types.ts";
import CopyButton from "./CopyButton.astro";

/**
 * Command block with optional audience tabs (the "Human / Agent" pattern). Each tab holds real
 * commands; Copy copies the selected tab's commands without prompts or comments.
 * Without JavaScript every tab renders stacked under its own label.
 */

interface Props {
  /** Unique on the page; prefixes ids. */
  id: string;
  /** Accessible name of the tab list, for example "Audience". */
  label: string;
  tabs: CodeTab[];
  class?: string;
}

const { id, label, tabs, class: className } = Astro.props;
const copyText = (tab: CodeTab): string =>
  tab.lines
    .flatMap((line) => (line.cmd ? [line.cmd] : []))
    .join("\n");
---

<div class:list={["code", className]} data-code-tabs>
  <div class="code__bar">
    {
      tabs.length > 1 && (
        <div class="code__tabs" role="tablist" aria-label={label} hidden>
          {tabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              id={`${id}-tab-${tab.id}`}
              aria-controls={`${id}-panel-${tab.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
            >
              {tab.label}
            </button>
          ))}
        </div>
      )
    }
  </div>
  {
    tabs.map((tab, index) => (
      <div
        class="code__panel"
        id={`${id}-panel-${tab.id}`}
        role={tabs.length > 1 ? "tabpanel" : undefined}
        aria-labelledby={tabs.length > 1 ? `${id}-tab-${tab.id}` : undefined}
        data-initial={index === 0 ? "true" : "false"}
      >
        {tabs.length > 1 && <p class="code__nojs-label">{tab.label}</p>}
        <div class="code__head">
          <CopyButton label={`${tab.label.toLowerCase()} commands`} value={copyText(tab)} tone="dark" />
        </div>
        <pre tabindex="0" aria-label={`${tab.label} commands`}><code>{tab.lines.map((line) =>
          line.cmd ? (
            <span class="code__line"><span class="code__prompt" aria-hidden="true">$ </span>{line.cmd}{"\n"}</span>
          ) : (
            <span class="code__note">{`# ${line.note ?? ""}`}{"\n"}</span>
          ),
        )}</code></pre>
      </div>
    ))
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-code-tabs]")) {
    const list = root.querySelector<HTMLElement>("[role=tablist]");
    if (!list) continue;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (next: HTMLButtonElement, focus: boolean): void => {
      for (const tab of tabs) {
        const on = tab === next;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !on;
      }
      if (focus) next.focus();
    };
    list.hidden = false;
    root.classList.add("is-tabbed");
    const first = tabs[0];
    if (first) select(first, false);
    list.addEventListener("click", (event) => {
      const tab = (event.target as Element).closest<HTMLButtonElement>("[role=tab]");
      if (tab) select(tab, false);
    });
    list.addEventListener("keydown", (event) => {
      const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (current < 0) return;
      const moves: Record<string, number> = {
        ArrowRight: (current + 1) % tabs.length,
        ArrowLeft: (current - 1 + tabs.length) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      };
      const target = moves[event.key];
      const tab = target === undefined ? undefined : tabs[target];
      if (!tab) return;
      event.preventDefault();
      select(tab, true);
    });
  }
</script>

<style>
  .code {
    position: relative;
    border-radius: var(--radius-md);
    background: var(--night);
    color: var(--night-text);
    overflow: hidden;
  }

  .code__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-3) 0;
  }

  .code__tabs {
    display: inline-flex;
    padding: 3px;
    border: 1px solid rgb(237 235 245 / 0.14);
    border-radius: calc(var(--radius-sm) + 3px);
  }

  .code__tabs[hidden] {
    display: none;
  }

  .code__tabs button {
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--night-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--dur-base) ease,
      color var(--dur-base) ease;
  }

  .code__tabs button:hover {
    color: var(--night-text);
  }

  .code__tabs button[aria-selected="true"] {
    background: var(--lav);
    color: var(--ink);
  }

  .code__tabs button:focus-visible {
    outline-color: var(--lav);
    outline-offset: 2px;
  }

  .code__panel {
    position: relative;
    padding: var(--space-2) 0 var(--space-4);
  }

  .code__panel + .code__panel {
    border-top: 1px solid rgb(237 235 245 / 0.1);
  }

  .is-tabbed .code__panel + .code__panel {
    border-top: 0;
  }

  .code__nojs-label {
    padding: var(--space-3) var(--space-5) 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--night-muted);
  }

  .is-tabbed .code__nojs-label {
    display: none;
  }

  .code__head {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
  }

  .is-tabbed .code__head {
    top: calc(-2.25rem - var(--space-2));
  }

  pre {
    margin: 0;
    padding: var(--space-4) var(--space-5) var(--space-2);
    overflow-x: auto;
    font-size: var(--text-sm);
    line-height: 1.75;
    white-space: pre;
    tab-size: 2;
  }

  pre:focus-visible {
    outline: 2px solid var(--lav);
    outline-offset: -4px;
  }

  .code__prompt {
    color: var(--lav);
    user-select: none;
  }

  .code__note {
    color: var(--night-muted);
  }
</style>
