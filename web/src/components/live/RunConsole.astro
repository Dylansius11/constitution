---
import { readFlowConfig } from "../../lib/run-flow.ts";
import { surfaceView } from "../../lib/surface-view.ts";
import StageLadder from "../ui/StageLadder.astro";
import StatusBadge from "../ui/StatusBadge.astro";

/**
 * Run it in the browser (PRD F10, DESIGN 5 row 7). Two flows submit the committed fixtures with the
 * public demo key and follow them through the real stages. Before activation both cards render in
 * an honest locked state: the button is disabled, says why, and the ladder lists the stages a run
 * will report. Nothing on a locked card is presented as having happened.
 */
const env = Object.fromEntries(
  Object.entries(import.meta.env).filter((entry): entry is [string, string] => typeof entry[1] === "string"),
);
const config = readFlowConfig(env);
const idle = surfaceView({ kind: "idle" });

const flows = [
  {
    kind: "attack",
    fixture: "VaultV2Drain",
    title: "Run the attack",
    pitch:
      "A drain dressed as a fee update. Submit it with the public demo key and watch the committed rules handle it.",
    expect: "Expected: refused by R2 Solvency. No signature is requested and the vault keeps its implementation.",
  },
  {
    kind: "honest",
    fixture: "VaultV2Honest",
    title: "Run the honest upgrade",
    pitch:
      "An append-only feature upgrade. Submit it and follow it from NEAR, through the verifier, to Base Sepolia.",
    expect: "Expected: certified, signed by the NEAR MPC network and executed on Base Sepolia.",
  },
] as const;
---

<div class="console" data-run-console data-enabled={config ? "true" : "false"}>
  {
    flows.map((flow) => (
      <article
        class="console__card"
        data-flow={flow.kind}
        data-tone="neutral"
        aria-labelledby={`run-${flow.kind}-title`}
      >
        <div class="console__top">
          <p class="console__fixture mono">{flow.fixture}</p>
          {config ? (
            <StatusBadge tone="observed">Testnet</StatusBadge>
          ) : (
            <StatusBadge tone="awaiting">Awaiting activation</StatusBadge>
          )}
        </div>
        <h3 id={`run-${flow.kind}-title`} class="console__title">
          {flow.title}
        </h3>
        <p class="console__pitch">{flow.pitch}</p>
        <p class="console__expect">{flow.expect}</p>
        <p class="console__expect">Public fixture source only. This page seals to an unappraised verifier key; do not use it for private source.</p>

        {config ? (
          <button type="button" class="console__go" data-run>
            Run on testnet
          </button>
        ) : (
          <button type="button" class="console__go" disabled>
            Opens at activation
          </button>
        )}

        <div class="console__status" aria-live="polite" data-run-status>
          <p class="console__state" data-run-title>
            {config ? "Ready" : "Not running yet"}
          </p>
          <p class="console__detail" data-run-body>
            {config
              ? "One run submits one proposal with the demo key. Every stage below is read from NEAR, the verifier or Base Sepolia."
              : "The production gate, the attested verifier and the demo key are not live. Until then, the commands below run the same checks from a checkout."}
          </p>
          <a class="console__link" data-run-near hidden rel="noopener">
            View the proposal transaction on NEAR testnet
          </a>
        </div>

        <details class="console__stages" open={config ? true : undefined}>
          <summary class="console__ladder-label mono">
            {config ? "Stages" : `The ${idle.stages.length} stages a run will report`}
          </summary>
          <StageLadder stages={idle.stages} label={`${flow.title}: stages`} compact />
        </details>
      </article>
    ))
  }
</div>

<script>
  import "./run-console.ts";
</script>

<style>
  .console {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .console__card {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition: border-color var(--dur-swap) var(--ease-out);
  }

  .console__card[data-tone="pass"] {
    border-color: var(--pass);
  }

  .console__card[data-tone="refuse"] {
    border-color: var(--refuse);
  }

  .console__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .console__fixture {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-muted);
  }

  .console__title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  .console__pitch {
    max-width: 44ch;
  }

  .console__expect {
    padding-left: var(--space-4);
    border-left: 2px solid var(--lav);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .console__go {
    justify-self: start;
    min-height: 3rem;
    padding: 0 var(--space-6);
    border: 1px solid var(--ink);
    border-radius: var(--radius-sm);
    background: var(--lav);
    color: var(--ink);
    font-size: var(--text-base);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--dur-base) ease,
      transform var(--dur-press) var(--ease-out);
  }

  .console__go:hover:not(:disabled, [aria-disabled="true"]) {
    background: var(--lav-hover);
  }

  .console__go:active:not(:disabled, [aria-disabled="true"]) {
    transform: scale(0.97);
  }

  .console__go:disabled,
  .console__go[aria-disabled="true"] {
    border-color: var(--line-strong);
    background: transparent;
    color: var(--ink-muted);
    cursor: not-allowed;
  }

  .console__status {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }

  .console__state {
    font-weight: 600;
  }

  .console__detail {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .console__link {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .console__stages > :global(.ladder) {
    margin-top: var(--space-3);
  }

  .console__ladder-label {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    cursor: pointer;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-muted);
  }

  @media (max-width: 56rem) {
    .console {
      grid-template-columns: minmax(0, 1fr);
    }

    .console__card {
      padding: var(--space-5);
    }
  }
</style>
