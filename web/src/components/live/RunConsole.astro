---
import { finalRuns } from "../../data/final-evidence.ts";
import { site } from "../../data/site.ts";
import { readFlowConfig } from "../../lib/run-flow.ts";
import { surfaceView } from "../../lib/surface-view.ts";
import StageLadder from "../ui/StageLadder.astro";
import StatusBadge from "../ui/StatusBadge.astro";

/**
 * Run it in the browser (PRD F10, DESIGN 5 row 7). With a complete run configuration two flows
 * submit the committed fixtures with the public demo key and follow them through the real stages.
 * Without one (the state of the final gate) the cards are not runnable and say why: the proxy was
 * already upgraded, so a new proposal is refused at rule 0. They point at the recorded receipts
 * and at what a reader can still do. Nothing on a locked card is presented as a live run.
 */
const env = Object.fromEntries(
  Object.entries(import.meta.env).filter((entry): entry is [string, string] => typeof entry[1] === "string"),
);
const config = readFlowConfig(env);
const idle = surfaceView({ kind: "idle" });
const { drain, honest } = finalRuns;

const flows = [
  {
    kind: "attack",
    fixture: "VaultV2Drain",
    title: "Run the attack",
    pitch:
      "A drain dressed as a fee update. Submit it with the public demo key and watch the committed rules handle it.",
    expect: "Expected: refused by R2 Solvency. No signature is requested and the vault keeps its implementation.",
    recordedTitle: "The attack, as recorded",
    recordedPitch: "A drain dressed as a fee update, submitted to this gate as proposal 0.",
    recorded: `Recorded: refused under ${drain.ruleId} ${drain.ruleName}, reason ${drain.reasonCode}. No signature was requested and the proxy kept VaultV1.`,
    receiptHref: "#receipt-drain",
  },
  {
    kind: "honest",
    fixture: "VaultV2Honest",
    title: "Run the honest upgrade",
    pitch:
      "An append-only feature upgrade. Submit it and follow it from NEAR, through the verifier, to Base Sepolia.",
    expect: "Expected: certified, signed by the NEAR MPC network and executed on Base Sepolia.",
    recordedTitle: "The honest upgrade, as recorded",
    recordedPitch: "An append-only feature upgrade, submitted to this gate as proposal 1.",
    recorded: `Recorded: certified, signed by the NEAR MPC network and executed on Base Sepolia, block ${honest.block.toLocaleString("en-US")}.`,
    receiptHref: "#receipt-honest",
  },
] as const;
---

{
  !config && (
    <section class="console__notice" aria-labelledby="console-closed-title">
      <h4 id="console-closed-title">Live runs are closed on this gate</h4>
      <p>
        The proxy was already upgraded to VaultV2Honest, and the committed manifest's reference
        source is VaultV1. A new proposal is now refused at rule 0, <span class="mono">current source runtime mismatch</span>,
        before R2 can run, so the attack cannot be replayed here. The recorded receipts are the
        evidence. There is no public demo key on this page.
      </p>
      <p class="console__can">What you can still do:</p>
      <ul>
        <li>
          Read the <a href="#receipt-final">recorded receipts</a>, each with its NEAR and Base Sepolia
          transactions.
        </li>
        <li>
          Read the gate's state live in <a href="#gate-ledger">the ledger</a> and the{" "}
          <a href="#timelock">timelock queue</a>.
        </li>
        {
          site.gateAccount !== null && (
            <li>
              Watch proposal ids <span class="mono">{drain.proposalId}</span> and <span class="mono">{honest.proposalId}</span> with the <a href="#proposal-watch">proposal watcher</a>.
            </li>
          )
        }
        <li>
          Run <span class="mono">constitution audit</span> and <span class="mono">constitution receipt &lt;id&gt;</span> from a checkout, with the commands below.
        </li>
      </ul>
    </section>
  )
}

<div class="console" data-run-console data-enabled={config ? "true" : "false"}>
  {
    flows.map((flow) => (
      <article
        class="console__card"
        data-flow={flow.kind}
        data-tone="neutral"
        aria-labelledby={`run-${flow.kind}-title`}
      >
        <div class="console__top">
          <p class="console__fixture mono">{flow.fixture}</p>
          {config ? (
            <StatusBadge tone="observed">Testnet</StatusBadge>
          ) : (
            <StatusBadge tone="recorded">Recorded, not runnable</StatusBadge>
          )}
        </div>
        <h4 id={`run-${flow.kind}-title`} class="console__title">
          {config ? flow.title : flow.recordedTitle}
        </h4>
        <p class="console__pitch">{config ? flow.pitch : flow.recordedPitch}</p>
        <p class="console__expect">{config ? flow.expect : flow.recorded}</p>

        {config ? (
          <>
            <p class="console__expect">Public fixture source only. This page seals to an unappraised verifier key; do not use it for private source.</p>
            <button type="button" class="console__go" data-run>
              Run on testnet
            </button>
            <div class="console__status" aria-live="polite" data-run-status>
              <p class="console__state" data-run-title>
                Ready
              </p>
              <p class="console__detail" data-run-body>
                One run submits one proposal with the demo key. Every stage below is read from NEAR, the verifier or Base Sepolia.
              </p>
              <a class="console__link" data-run-near hidden rel="noopener">
                View the proposal transaction on NEAR testnet
              </a>
            </div>
            <details class="console__stages" open>
              <summary class="console__ladder-label mono">Stages</summary>
              <StageLadder stages={idle.stages} label={`${flow.title}: stages`} compact />
            </details>
          </>
        ) : (
          <a class="console__go console__go--link" href={flow.receiptHref}>
            Read the recorded receipt
          </a>
        )}
      </article>
    ))
  }
</div>

<script>
  import "./run-console.ts";
</script>

<style>
  .console__notice {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    padding: var(--space-5) var(--space-6);
    border-left: 3px solid var(--lav);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .console__notice h4 {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
  }

  .console__notice p,
  .console__notice ul {
    max-width: 62ch;
  }

  .console__notice ul {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
    font-size: var(--text-sm);
  }

  .console__can {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .console__go--link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .console {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .console__card {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition: border-color var(--dur-swap) var(--ease-out);
  }

  .console__card[data-tone="pass"] {
    border-color: var(--pass);
  }

  .console__card[data-tone="refuse"] {
    border-color: var(--refuse);
  }

  .console__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .console__fixture {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-muted);
  }

  .console__title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  .console__pitch {
    max-width: 44ch;
  }

  .console__expect {
    padding-left: var(--space-4);
    border-left: 2px solid var(--lav);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .console__go {
    justify-self: start;
    min-height: 3rem;
    padding: 0 var(--space-6);
    border: 1px solid var(--ink);
    border-radius: var(--radius-sm);
    background: var(--lav);
    color: var(--ink);
    font-size: var(--text-base);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--dur-base) ease,
      transform var(--dur-press) var(--ease-out);
  }

  .console__go:hover:not(:disabled, [aria-disabled="true"]) {
    background: var(--lav-hover);
  }

  .console__go:active:not(:disabled, [aria-disabled="true"]) {
    transform: scale(0.97);
  }

  .console__go:disabled,
  .console__go[aria-disabled="true"] {
    border-color: var(--line-strong);
    background: transparent;
    color: var(--ink-muted);
    cursor: not-allowed;
  }

  .console__status {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }

  .console__state {
    font-weight: 600;
  }

  .console__detail {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .console__link {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .console__stages > :global(.ladder) {
    margin-top: var(--space-3);
  }

  .console__ladder-label {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    cursor: pointer;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-muted);
  }

  @media (max-width: 56rem) {
    .console {
      grid-template-columns: minmax(0, 1fr);
    }

    .console__card {
      padding: var(--space-5);
    }
  }
</style>
