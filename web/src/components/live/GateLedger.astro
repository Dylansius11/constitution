---
import { site } from "../../data/site.ts";
import StatusBadge from "../ui/StatusBadge.astro";
import "./live.css";

interface Props {
  id?: string;
  /** The gate to read; defaults to the final gate of this build. */
  gate?: string | null;
  /** Accessible name of the list: say which gate it is. */
  label?: string;
  /** Row keys to leave out. */
  omit?: string[];
}

const {
  id = "gate-ledger",
  gate = site.gateAccount,
  label = "Production deployment status",
  omit = [],
} = Astro.props;
const rows = [
  ["gate", "Gate account"],
  ["accessKeys", "Gate access keys"],
  ["rules", "Active rule set"],
  ["verifiers", "Verifier allowlist"],
  ["changes", "Timelock queue"],
  ["proxy", "Protected proxy implementation"],
].filter(([key]) => !omit.includes(key as string));
---

<div
  id={id}
  class="live-surface"
  data-ledger
  data-gate={gate}
  data-near-rpc={site.nearRpc}
  data-base-rpc={site.baseRpc}
>
  <dl aria-label={label}>
    {
      rows.map(([key, label]) => (
        <div class="live-row" data-ledger-row={key}>
          <dt>{label}</dt>
          <dd>
            {gate === null ? (
              <StatusBadge tone="awaiting">No gate configured</StatusBadge>
            ) : (
              <>
                <span data-value>Not read</span>
                <span data-row-error class="live-meta"></span>
                <span data-row-time class="live-meta"></span>
              </>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
  {
    gate === null ? (
      <p class="live-intro">
        This build has no gate account configured, so these rows read no chain. Set PUBLIC_GATE_ACCOUNT at build time to read a gate.
      </p>
    ) : (
      <>
        <output aria-live="polite" data-ledger-status>
          Reading the gate from NEAR testnet and Base Sepolia.
        </output>
        <button type="button" class="live-action" data-ledger-retry>
          Retry now
        </button>
        <p class="live-meta">
          Reads every 15 seconds while this tab is visible. Lists show the first 50 entries returned
          by the gate.
        </p>
        <noscript>
          <p>
            JavaScript is needed for chain reads. No live data has been observed by this page.
          </p>
        </noscript>
      </>
    )
  }
</div>

<script>
  import "./gate-ledger.ts";
</script>
