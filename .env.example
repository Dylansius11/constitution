# Names only. Copy to .env (gitignored) and fill locally. See docs/technical/INTEGRATIONS.md.
# Secrets marked [secret] never go in chat, docs, logs or commits.

NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
GATE_ACCOUNT_ID=
GUARDIAN_ACCOUNT_ID=
DEMO_GOVERNOR_ACCOUNT_ID=
PUBLIC_DEMO_GOVERNOR_KEY=
VERIFIER_RELAY_ACCOUNT_ID=
# [secret path] near-cli key file of a function-call key limited to submit_verdict
VERIFIER_RELAY_KEY_FILE=

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_SEND_URL=https://sepolia-sequencer.base.org
# [secret] Validation Cloud endpoint, contains the key
BASE_SEPOLIA_ARCHIVE_RPC_URL=
# Proof endpoint must serve the same pinned Base block; public RPC is rate-limited.
BASE_SEPOLIA_PROOF_RPC_URL=https://sepolia.base.org

# [secret]
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=z-ai/glm-5.3-flash

VERIFIER_URL=
EXECUTOR_ADDRESS=
PAGE_ORIGIN=

PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
PUBLIC_BASE_RPC_URL=https://sepolia.base.org
PUBLIC_GATE_ACCOUNT_ID=
PUBLIC_VERIFIER_URL=
PUBLIC_EXECUTOR_ADDRESS=
PUBLIC_EXPLORER_BASE_URL=https://sepolia.basescan.org
PUBLIC_EXPLORER_FALLBACK_URL=https://base-sepolia.blockscout.com
PUBLIC_X_POST_URL=

# [secret] optional, only if Etherscan verification is chosen
ETHERSCAN_API_KEY=
# EVM deployer key lives in a Foundry encrypted keystore (--account deployer), never here.
